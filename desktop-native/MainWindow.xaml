<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AP Tech Work Station · Native Preview" Width="1180" Height="800" MinWidth="920" MinHeight="650" Background="#0D1715" Foreground="#EBF4EF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EBF4EF"/><Setter Property="Background" Value="#20372F"/><Setter Property="BorderBrush" Value="#30483D"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,8,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="#2E5545"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#10211B"/><Setter Property="Foreground" Value="#EBF4EF"/><Setter Property="BorderBrush" Value="#365044"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,8,0,14"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#10211B"/><Setter Property="Foreground" Value="#EBF4EF"/><Setter Property="BorderBrush" Value="#365044"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,8,0,14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#15251F"/><Setter Property="BorderBrush" Value="#2C4035"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,18,18"/></Style>
 </Window.Resources>
 <Grid Background="#0D1715"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101F19" BorderBrush="#2B3D32" BorderThickness="0,0,1,0"><DockPanel Margin="22,30,16,20">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,38"><Border Background="#233D2B" CornerRadius="10" Padding="12"><TextBlock Text="AP" FontWeight="Bold" Foreground="#E6B85D" FontSize="20"/></Border><StackPanel Margin="12,2,0,0"><TextBlock Text="Work Station" FontSize="17" FontWeight="Bold"/><TextBlock Text="AP TECH AGENCY" FontSize="10" Foreground="#97B3A2" Margin="0,7,0,0"/></StackPanel></StackPanel>
    <Button Name="Overview" Content="Overview" HorizontalContentAlignment="Left"/><Button Name="Shift" Content="My shift / profile"/><Button Name="Tasks" Content="Daily tasks"/><Button Name="Chat" Content="Visitor chat"/><Button Name="Settings" Content="Settings"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="NATIVE WINDOWS PREVIEW" FontSize="10" Foreground="#D7B56A" Margin="0,18,0,12"/><TextBlock Name="PcLabel" TextWrapping="Wrap" Foreground="#A5BBAE"/><TextBlock Text="No browser engine · WPF" Foreground="#7E9A88" FontSize="11" Margin="0,12,0,0"/></StackPanel>
  </DockPanel></Border>
  <DockPanel Grid.Column="1" Margin="30,30,16,16">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="AP TECH HUB  /  BANGLADESH TIME" FontSize="11" Foreground="#8DAA99"/><TextBlock Name="Heading" Text="Your day, clearly organised." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Name="Subtitle" Text="Your shift, work and customer conversations — together." Foreground="#9EB5A6" Margin="0,0,0,22"/></StackPanel>
   <Border DockPanel.Dock="Bottom" Padding="0,10"><TextBlock Name="Status" Text="Preview · No tracking starts automatically in this build." TextWrapping="Wrap" Foreground="#9DC5AD"/></Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Name="Content"/></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
