{
  "manifest_version": 3,
  "name": "AP Tech Visible Work Tracker",
  "version": "0.2.1",
  "description": "Opt-in work-site refresh and interaction counts. No messages or clipboard contents.",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": ["https://www.aptechagency.com/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "options.html", "default_title": "AP Tech Work Tracker - click to pause" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["https://www.fiverr.com/*", "https://www.upwork.com/*", "https://www.freelancer.com/*"], "js": ["counter.js"] }]
}
