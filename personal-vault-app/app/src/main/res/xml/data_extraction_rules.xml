<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicitly excludes everything from cloud backup / device transfer.
  The vault's protection model assumes its encrypted store never leaves
  this device via Android's backup mechanisms.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
