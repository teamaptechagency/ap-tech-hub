model SupportTicket {
  id            String    @id @default(cuid())
  type          String    @default("FEEDBACK") // BUG | FEEDBACK | FEATURE | OTHER
  priority      String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status        String    @default("OPEN") // OPEN | REVIEWING | PLANNED | RESOLVED | CLOSED
  title         String
  description   String
  pageUrl       String?
  screenshotUrl String?
  reporterId    String
  reporter      User      @relation("SupportTicketReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedToId  String?
  assignedTo    User?     @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  adminNote     String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
}

// ============================================
// CLIENT JOB REQUESTS
// ============================================

model JobRequest {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String
  budgetHint  String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

// ============================================
// MEETINGS (Jitsi, admin approval)
// ============================================

enum MeetingStatus {
  PENDING_APPROVAL
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  scheduledAt  DateTime
  roomCode     String               @unique @default(cuid())
  status       MeetingStatus        @default(PENDING_APPROVAL)
  jobId        String?
  job          Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  participants MeetingParticipant[]
  createdAt    DateTime             @default(now())
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

// ============================================
// RATINGS + EXTENSIONS + NOTIFICATIONS + AUDIT
// ============================================

model Rating {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User     @relation("RatedWorker", fields: [workerId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  stars     Int
  review    String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([jobId, workerId])
}

model ExtensionRequest {
  id            String        @id @default(cuid())
  jobId         String
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  milestoneId   String?
  requestedById String
  newDate       DateTime
  reason        String?
  status        RequestStatus @default(PENDING)
  processedById String?
  createdAt     DateTime      @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())
}
