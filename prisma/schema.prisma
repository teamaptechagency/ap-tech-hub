generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USERS & ROLES
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  CEO
  TEAM_MEMBER
  // Special Order partner (marketplace delivery work) — the /p/ portal.
  BUSINESS_PARTNER
  PARTNER_MANAGER
  // Referral/reseller partner who brings clients in — the /r/ portal.
  // Deliberately a separate role: it must never reach Special Order data.
  REFERRAL_PARTNER
  CLIENT
  CLIENT_MANAGER
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  role                 Role      @default(TEAM_MEMBER)
  image                String?
  timezone             String    @default("Asia/Dhaka")
  // Client-side users (CLIENT / CLIENT_MANAGER) link to a Client company
  clientId             String?
  client               Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Worker payout info (set by the worker in their profile)
  payoutMethod         String?
  payoutDetails        String?
  withdrawBlockedUntil DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorMethod      String    @default("EMAIL")
  twoFactorCode        String?
  twoFactorCodeExp     DateTime?
  totpSecret           String?
  // Cached money (ledger = WorkerTxn)
  balance              Decimal   @default(0) @db.Decimal(12, 2)
  reserve              Decimal   @default(0) @db.Decimal(12, 2)
  // First-login terms acceptance
  termsAcceptedAt      DateTime?
  termsVersion         String?

  // Public registration profile
  phone            String?
  address          String?
  dateOfBirth      DateTime?
  emergencyContact String?
  bio              String?
  gender           String? // MALE | FEMALE | OTHER
  profession       String? // e.g. "UI/UX Designer"
  nidUrl           String? // NID/Passport document
  nidNumber        String?
  photoUrl         String? // profile photo
  identityStatus   String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED

  // Registration approval + password reset
  accountStatus String    @default("ACTIVE") // ACTIVE | PENDING_APPROVAL | REJECTED
  resetToken    String?   @unique
  resetTokenExp DateTime?

  // Presence (client-facing team directory status dot)
  lastActiveAt DateTime?
  presenceBusy Boolean   @default(false)

  // Partner-facing: what this partner's business does. Replaces the
  // admin-managed Skill list, which only makes sense for team members.
  businessBrief String?
  // SO_PARTNER | REFERENCE_PARTNER | REGULAR_CONTRACT_PARTNER. Role still
  // controls portal access; this labels the business relationship.
  partnerType   String?

  // A PARTNER_MANAGER belongs to exactly one partner account, who creates
  // the account and controls its permissions. Null on a manager means the
  // account predates this link and is not yet assigned to a partner.
  managedByPartnerId String?
  managedByPartner   User?   @relation("PartnerManagers", fields: [managedByPartnerId], references: [id], onDelete: Cascade)
  partnerManagers    User[]  @relation("PartnerManagers")

  skills                 Skill[]
  jobMemberships         JobMember[]
  workSessions           WorkSession[]
  applications           Application[]
  assignedTasks          WeeklyTask[]               @relation("TaskAssignee")
  completedTasks         WeeklyTask[]               @relation("TaskCompleter")
  cancelledTasks         WeeklyTask[]               @relation("TaskCanceller")
  assignedMilestones     Milestone[]                @relation("MilestoneAssignee")
  sentMessages           Message[]
  displayedMessages      Message[]                  @relation("MessageDisplaySender")
  uploadedAttachments    Attachment[]               @relation("AttachmentUploader")
  conversations          ConversationParticipant[]
  workerTxns             WorkerTxn[]
  withdrawRequests       WithdrawRequest[]
  ratingsReceived        Rating[]                   @relation("RatedWorker")
  meetingsCreated        Meeting[]                  @relation("MeetingCreator")
  meetings               MeetingParticipant[]
  notifications          Notification[]
  paymentSubmissions     PaymentSubmission[]
  profileChangeRequests  UserProfileChangeRequest[]
  profileChangeReviews   UserProfileChangeRequest[] @relation("ProfileChangeReviewer")
  supportTickets         SupportTicket[]            @relation("SupportTicketReporter")
  supportTicketsAssigned SupportTicket[]            @relation("SupportTicketAssignee")
  specialOrdersWorked    SpecialOrder[]             @relation("SpecialOrderPartner")
  specialOrdersCreated   SpecialOrder[]             @relation("SpecialOrderCreator")
  specialProfiles        SpecialOrderProfile[]      @relation("SpecialOrderProfilePartner")
  defaultMarketplaces    Marketplace[]              @relation("MarketplaceDefaultPartner")
  permissions            UserPermission[]
  blogPosts              BlogPost[]                 @relation("BlogPostAuthor")
  passkeys               UserPasskey[]
  referralPartner        ReferralPartner?           @relation("ReferralPartnerAccount")
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
}

model LoginSecurityRecord {
  id            String    @id @default(cuid())
  key           String    @unique
  email         String?
  ipAddress     String
  failedCount   Int       @default(0)
  holdLevel     Int       @default(0)
  holdUntil     DateTime?
  hardBlocked   Boolean   @default(false)
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([ipAddress])
  @@index([holdUntil])
  @@index([hardBlocked])
}

model IpBlock {
  id             String    @id @default(cuid())
  ipAddress      String    @unique
  reason         String
  active         Boolean   @default(true)
  blockedBy      String    @default("SYSTEM")
  blockedUntil   DateTime?
  unlockedAt     DateTime?
  unlockToken    String?   @unique
  unlockTokenExp DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active])
  @@index([blockedUntil])
  @@index([unlockToken])
}

model LoginHelpRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  ipAddress String?
  status    String   @default("OPEN")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model UserLoginPin {
  id        String   @id @default(cuid())
  userId    String   @unique
  pinHash   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserLoginDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceToken String   @unique
  ipAddress   String?
  userAgent   String?
  country     String?
  city        String?
  region      String?
  trusted     Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([lastSeenAt])
  @@index([trusted])
}

enum ProfileChangeType {
  EMAIL
  PHONE
  PAYOUT
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserProfileChangeRequest {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 ProfileChangeType
  oldValue             String?
  newValue             String
  status               ProfileChangeStatus @default(PENDING)
  withdrawBlockedUntil DateTime
  reviewedById         String?
  reviewedBy           User?               @relation("ProfileChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  note                 String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource  String
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(true)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, resource])
  @@index([userId])
  @@index([resource])
}

// ============================================
// PASSKEYS (WebAuthn / fingerprint, Face ID, Windows Hello)
// ============================================

model UserPasskey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Base64URL credential ID returned by the authenticator.
  credentialId String  @unique
  publicKey    Bytes
  // Signature counter; a value that fails to advance signals a cloned key.
  counter      Int     @default(0)
  // Comma-separated AuthenticatorTransport values ("internal,hybrid").
  transports   String?
  deviceType   String?
  backedUp     Boolean @default(false)
  // User-facing name so someone with several devices can tell them apart.
  label        String  @default("Passkey")

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  // Random handle held in a short-lived httpOnly cookie, so a challenge can
  // only be completed by the browser that requested it.
  handle    String   @unique
  userId    String?
  challenge String
  // REGISTER | LOGIN | STEP_UP
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// SKILLS (admin-managed master list)
// ============================================

model Skill {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
  jobs  Job[]
}

// ============================================
// CLIENTS (portal-capable clients)
// ============================================

enum ClientType {
  LOCAL
  WEBSITE
  MARKETPLACE
}

enum ClientMarketplace {
  FIVERR
  UPWORK
  FREELANCER
  OTHER
}

model Client {
  id          String             @id @default(cuid())
  companyName String
  contactName String
  email       String             @unique
  phone       String?
  country     String?
  clientType  ClientType         @default(WEBSITE)
  marketplace ClientMarketplace?
  status      String             @default("ACTIVE")
  currency    String             @default("USD")
  timezone    String             @default("UTC")
  // Cached wallet (ledgers = ClientTxn / PointTxn)
  balance     Decimal            @default(0) @db.Decimal(12, 2)
  points      Int                @default(0)

  users              User[]
  jobs               Job[]
  invoices           Invoice[]
  walletTxns         ClientTxn[]
  referrals          Referral[]
  pointTxns          PointTxn[]
  paymentSubmissions PaymentSubmission[]
  exchangeRequests   PointExchangeRequest[]
  ratings            Rating[]
  jobRequests        JobRequest[]
  specialOrders      SpecialOrder[]
  specialProfiles    SpecialOrderProfile[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

// ============================================
// UNIFIED JOB (Monthly / Fixed / Hourly)
// ============================================

enum JobType {
  MONTHLY
  FIXED
  HOURLY
}

enum JobStatus {
  PENDING
  OPEN
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model Job {
  id          String        @id @default(cuid())
  title       String
  description String?
  type        JobType
  status      JobStatus     @default(PENDING)
  publish     PublishStatus @default(DRAFT)

  // Internal client OR external (Fiverr/Upwork) info
  clientId        String?
  client          Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  externalSource  String?
  externalName    String?
  externalCountry String?

  // Client-side pricing (what the client sees)
  // MONTHLY: per month | FIXED: total budget | HOURLY: per hour
  clientValue    Decimal? @db.Decimal(12, 2)
  clientCurrency String   @default("USD")
  vatPercent     Decimal? @db.Decimal(5, 2)

  // Default worker payout visible before application.
  // MONTHLY: per month | FIXED: total | HOURLY: per hour
  workerValue    Decimal? @db.Decimal(12, 2)
  workerCurrency String   @default("BDT")

  // Type-specific fields
  startDate       DateTime?
  billingDay      Int?
  deadline        DateTime?
  weeklyHourLimit Int?
  pausedAt        DateTime?

  requiredSkills Skill[]
  members        JobMember[]
  weeks          Week[]
  milestones     Milestone[]
  checkItems     CheckItem[]
  workSessions   WorkSession[]
  conversation   Conversation?
  applications   Application[]
  invoices       Invoice[]
  attachments    Attachment[]
  ratings        Rating[]
  extensions     ExtensionRequest[]
  meetings       Meeting[]
  workerTxns     WorkerTxn[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// Assignment + per-worker payment (worker value)
// MONTHLY: per month | FIXED: total | HOURLY: per hour
model JobMember {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerValue    Decimal  @default(0) @db.Decimal(12, 2)
  workerCurrency String   @default("BDT")
  createdAt      DateTime @default(now())

  @@unique([jobId, userId])
}

// ============================================
// MONTHLY: WEEKS + TASKS + TEMPLATES
// ============================================

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Week {
  id         String       @id @default(cuid())
  jobId      String
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  weekNumber Int
  startDate  DateTime
  endDate    DateTime
  tasks      WeeklyTask[]

  @@unique([jobId, weekNumber])
}

model WeeklyTask {
  id            String       @id @default(cuid())
  weekId        String
  week          Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  title         String
  priority      Priority     @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  sortOrder     Int          @default(0)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedById String?
  completedBy   User?        @relation("TaskCompleter", fields: [completedById], references: [id])
  completedAt   DateTime?
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?        @relation("TaskCanceller", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  attachments   Attachment[]
  createdAt     DateTime     @default(now())
}

model CommonTask {
  id        String   @id @default(cuid())
  title     String
  priority  Priority @default(MEDIUM)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================
// FIXED: MILESTONES + CHECK ITEMS
// ============================================

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Milestone {
  id          String          @id @default(cuid())
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String
  description String?
  deadline    DateTime?
  charge      Decimal?        @db.Decimal(12, 2)
  status      MilestoneStatus @default(PENDING)
  sortOrder   Int             @default(0)
  assigneeId  String?
  assignee    User?           @relation("MilestoneAssignee", fields: [assigneeId], references: [id])
  completedAt DateTime?
  attachments Attachment[]
  createdAt   DateTime        @default(now())
}

model CheckItem {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean @default(false)
  sortOrder Int     @default(0)
}

// ============================================
// HOURLY: WORK SESSIONS
// ============================================

model WorkSession {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  duration    Int?
  note        String?
  attachments Attachment[]
  createdAt   DateTime     @default(now())
}

// ============================================
// MARKETPLACE APPLICATIONS
// ============================================

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

model Application {
  id               String            @id @default(cuid())
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  message          String?
  deliveryEstimate String?
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())

  @@unique([jobId, userId])
}

// ============================================
// CHAT (job discussions + direct messages)
// ============================================

model Conversation {
  id                    String                    @id @default(cuid())
  jobId                 String?                   @unique
  job                   Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  specialOrderClientId  String?                   @unique
  specialOrderClient    SpecialOrder?             @relation("SpecialOrderClientConversation", fields: [specialOrderClientId], references: [id], onDelete: Cascade)
  specialOrderPartnerId String?                   @unique
  specialOrderPartner   SpecialOrder?             @relation("SpecialOrderPartnerConversation", fields: [specialOrderPartnerId], references: [id], onDelete: Cascade)
  isDirect              Boolean                   @default(false)
  participants          ConversationParticipant[]
  messages              Message[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @default(now()) @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id])
  // When an admin sends a message on behalf of a team member (client
  // direct chats), this is who the client should see as the sender.
  // Null for every normal message.
  displaySenderId String?
  displaySender   User?        @relation("MessageDisplaySender", fields: [displaySenderId], references: [id], onDelete: SetNull)
  body            String
  seenAt          DateTime?
  pinned          Boolean      @default(false)
  pinnedAt        DateTime?
  attachments     Attachment[]
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, pinned])
}

// ============================================
// ATTACHMENTS (files/images/video)
// ============================================

model Attachment {
  id                  String             @id @default(cuid())
  url                 String
  name                String
  size                Int?
  mimeType            String?
  uploadedById        String?
  uploadedBy          User?              @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  jobId               String?
  job                 Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messageId           String?
  message             Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  milestoneId         String?
  milestone           Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  taskId              String?
  task                WeeklyTask?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workSessionId       String?
  workSession         WorkSession?       @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  paymentSubmissionId String?
  paymentSubmission   PaymentSubmission? @relation(fields: [paymentSubmissionId], references: [id], onDelete: SetNull)
  specialOrderId      String?
  specialOrder        SpecialOrder?      @relation(fields: [specialOrderId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())

  @@index([uploadedById])
  @@index([jobId])
  @@index([messageId])
  @@index([milestoneId])
  @@index([taskId])
  @@index([workSessionId])
  @@index([paymentSubmissionId])
  @@index([specialOrderId])
}

// ============================================
// INVOICES (auto + custom, partial, VAT)
// ============================================

enum InvoiceType {
  AUTO
  CUSTOM
  SPECIAL_ORDER
}

enum InvoiceStatus {
  DUE
  PARTIALLY_PAID
  PAYMENT_SUBMITTED
  PAID
  OVERDUE
  CANCELLED
  ON_HOLD
}

model Invoice {
  id                  String        @id @default(cuid())
  number              String        @unique
  type                InvoiceType   @default(AUTO)
  title               String?
  jobId               String?
  job                 Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  specialOrderId      String?       @unique
  specialOrder        SpecialOrder? @relation(fields: [specialOrderId], references: [id], onDelete: SetNull)
  // Optional: an external project (Fiverr/Upwork/direct) has no Client
  // record, so it carries the buyer's details inline instead.
  clientId            String?
  client              Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  externalName        String?
  externalSource      String?
  externalCountry     String?
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("USD")
  vatPercent          Decimal?      @db.Decimal(5, 2)
  // Payment-method surcharge (e.g. the bKash cash-out fee), folded into the
  // total the same way VAT is. Percentage comes from Settings at the time the
  // invoice is raised, and is stored here so a later settings change never
  // rewrites an invoice that already went out.
  methodChargePercent Decimal?      @db.Decimal(5, 2)
  methodChargeLabel   String?

  // Shortfall the admin chose to absorb rather than chase. Kept explicit so
  // the gap between what was billed and what was received is never invisible.
  writtenOffAmount Decimal   @default(0) @db.Decimal(12, 2)
  writtenOffNote   String?
  writtenOffAt     DateTime?
  writtenOffById   String?

  // An advance/purchase invoice: the client is funding project costs, so
  // payment lands in their balance instead of the agency's earnings. It only
  // becomes revenue if and when it is actually earned.
  creditsClientBalance       Boolean              @default(false)
  balanceApplied             Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid                 Decimal              @default(0) @db.Decimal(12, 2)
  status                     InvoiceStatus        @default(DUE)
  periodStart                DateTime?
  periodEnd                  DateTime?
  dueDate                    DateTime
  paymentNote                String?
  submittedAt                DateTime?
  approvedById               String?
  paidVia                    String?
  payoneerInvoiceUrl         String?
  payoneerInvoiceButtonLabel String?
  payoneerInvoiceNote        String?
  items                      InvoiceItem[]
  paymentMethods             PaymentMethod[]
  paymentSubmissions         PaymentSubmission[]
  referralCommissions        ReferralCommission[]
  earning                    Earning?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@unique([jobId, periodStart])
}

enum SpecialOrderStatus {
  PLANNED
  ACTIVE
  DELIVERED
  COMPLETED
  CANCELLED
}

enum SpecialOrderReviewStatus {
  PENDING
  DONE
}

model SpecialOrder {
  id                       String                   @id @default(cuid())
  title                    String
  profileId                String?
  profile                  SpecialOrderProfile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)
  marketplaceId            String?
  marketplace              Marketplace?             @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  profileName              String?
  buyerProfile             String?
  niche                    String?
  conversationSheetUrl     String?
  orderDate                DateTime?
  plannedDate              DateTime?
  dueDate                  DateTime?
  deliveryDate             DateTime?
  orderAmountUsd           Decimal                  @db.Decimal(12, 2)
  clientUsdRate            Decimal                  @db.Decimal(12, 2)
  partnerUsdRate           Decimal                  @db.Decimal(12, 2)
  clientAmountBdt          Decimal                  @db.Decimal(12, 2)
  partnerCostBdt           Decimal                  @db.Decimal(12, 2)
  profitBdt                Decimal                  @db.Decimal(12, 2)
  status                   SpecialOrderStatus       @default(PLANNED)
  activeState              String?
  gigImageUrl              String?
  keyword                  String?
  profileLevel             String?
  reviewStatus             SpecialOrderReviewStatus @default(PENDING)
  privateFeedbackUrl       String?
  privateFeedbackDevice    String?
  privateFeedbackDate      DateTime?
  privateFeedback          String?
  reviewText               String?
  adminReviewText          String?
  partnerReviewText        String?
  reviewUrl                String?
  clientComment            String?
  partnerComment           String?
  deliveryNote             String?
  conversationMessages     Json?
  conversationFields       Json?
  conversationBreakMinutes Int                      @default(1)
  clientId                 String
  client                   Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partnerId                String?
  partner                  User?                    @relation("SpecialOrderPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  createdById              String?
  createdBy                User?                    @relation("SpecialOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  invoice                  Invoice?
  earning                  Earning?
  clientConversation       Conversation?            @relation("SpecialOrderClientConversation")
  partnerConversation      Conversation?            @relation("SpecialOrderPartnerConversation")
  attachments              Attachment[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([clientId])
  @@index([partnerId])
  @@index([profileId])
  @@index([marketplaceId])
  @@index([status])
  @@index([plannedDate])
}

model Marketplace {
  id               String                  @id @default(cuid())
  name             String                  @unique
  active           Boolean                 @default(true)
  clientUsdRate    Decimal                 @default(125) @db.Decimal(12, 2)
  partnerUsdRate   Decimal                 @default(115) @db.Decimal(12, 2)
  defaultPartnerId String?
  defaultPartner   User?                   @relation("MarketplaceDefaultPartner", fields: [defaultPartnerId], references: [id], onDelete: SetNull)
