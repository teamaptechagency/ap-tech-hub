  updatedAt       DateTime            @updatedAt

  @@index([paymentMethodId])
}

model PaymentSubmission {
  id                    String              @id @default(cuid())
  // INVOICE — paying an invoice. TOPUP — the client adding money to their own
  // balance, which has no invoice behind it.
  purpose               String              @default("INVOICE")
  invoiceId             String?
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Set when a reviewer turns the submission down, so the client can be told
  // why rather than just seeing it disappear.
  reviewNote            String?
  reviewedById          String?
  reviewedAt            DateTime?
  clientId              String
  client                Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  paymentMethodId       String?
  paymentMethod         PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  methodKey             String
  methodLabel           String
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("USD")
  paymentDate           DateTime
  selectedBankAccountId String?
  selectedBankAccount   BankPaymentAccount? @relation(fields: [selectedBankAccountId], references: [id], onDelete: SetNull)
  transactionId         String?
  secondaryReference    String?
  senderNumber          String?
  senderEmail           String?
  senderName            String?
  senderBankName        String?
  senderBankAccount     String?
  cardLast4             String?
  paymentSource         String?
  receiverName          String?
  note                  String?
  status                String              @default("PENDING")
  attachments           Attachment[]
  submittedById         String?
  submittedBy           User?               @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([invoiceId])
  @@index([clientId])
  @@index([paymentMethodId])
  @@index([selectedBankAccountId])
  @@index([submittedById])
}

